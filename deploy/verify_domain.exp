#!/usr/bin/expect -f

set timeout 20
set ip "120.25.165.230"
set user "root"
set password "nm,./=-098"

spawn ssh -o StrictHostKeyChecking=no $user@$ip "curl -s http://www.haifuxing.com | grep -o '<title>.*</title>'"
expect {
    "yes/no" {
        send "yes\r"
        exp_continue
    }
    "password:" {
        sleep 1
        send -- "$password\r"
        exp_continue
    }
    eof
}
